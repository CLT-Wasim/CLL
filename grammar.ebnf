(*
  grammar.ebnf - CLL v1 surface syntax
  ====================================

  Normative reference: docs/SPEC.md. This file and the SPEC must agree; when they
  do not, the SPEC wins and this file is the bug.

  Conventions
  -----------
  * ISO/IEC 14977 EBNF: `=` defines, `;` terminates, `|` alternates,
    `[ x ]` optional, `{ x }` zero or more, `( x )` grouping.
  * Terminals in double quotes are literal tokens. `(* ... *)` is a comment.
  * Rule names in UPPER_SNAKE are lexical tokens defined in SPEC R-LEX-*.
  * Every production is annotated with the SPEC rules it implements.

  Resolved grammar questions (see DECISIONS [149]..[154])
  -------------------------------------------------------
  * Reversible primitives are STATEMENTS, never expressions (R-REV-022).
  * `if ... fi` inside a `rev fn` carries a mandatory witness (R-REV-040).
  * `rev fn` has no return type (R-FN-010).
  * `local`/`delocal` are statements (R-REV-050).
*)


(* ---------------------------------------------------------------- module *)
(* R-MOD-001..004 *)

module          = { use_decl } , { item } ;
use_decl        = "use" , path , [ "as" , IDENT ] , ";" ;
path            = IDENT , { "::" , IDENT } ;


(* ----------------------------------------------------------------- items *)
(* R-FN-001..004, R-TYP-008, R-MOD-002 *)

item            = [ "pub" ] , ( fn_decl | rev_fn_decl | struct_decl
                              | enum_decl | const_decl | type_decl ) ;

fn_decl         = "fn" , IDENT , [ generic_params ] , "(" , [ params ] , ")"
                , [ "->" , type ] , block ;

rev_fn_decl     = "rev" , "fn" , IDENT , "(" , [ rev_params ] , ")" , block ;
                (* R-FN-010: no `->` clause is permitted on a `rev fn`. *)

pure_fn_decl    = "pure" , fn_decl ;
                (* R-FN-001: `pure` is a modifier on an ordinary declaration. *)

generic_params  = "[" , IDENT , { "," , IDENT } , "]" ;

params          = param , { "," , param } ;
param           = IDENT , ":" , type ;

rev_params      = rev_param , { "," , rev_param } ;
rev_param       = [ "mut" ] , IDENT , ":" , type ;
                (* Every `rev fn` parameter is state (R-REV-001). *)

struct_decl     = "struct" , IDENT , "{" , [ fields ] , "}" ;
fields          = field , { "," , field } , [ "," ] ;
field           = IDENT , ":" , type ;

enum_decl       = "enum" , IDENT , "{" , variant , { "," , variant } , [ "," ] , "}" ;
variant         = IDENT , [ "(" , type , { "," , type } , ")" ] ;

const_decl      = "const" , IDENT , ":" , type , "=" , expr , ";" ;
type_decl       = "type" , IDENT , "=" , type , ";" ;

annotation      = "#[" , IDENT , [ "(" , STRING , ")" ] , "]" ;
                (* R-CAP-030 `#[justify("...")]`, R-EFF-012 `#[conserving]`. *)


(* ----------------------------------------------------------------- types *)
(* R-TYP-001..032 *)

type            = primitive_type
                | fixed_type
                | array_type
                | slice_type
                | generic_type
                | "secret" , "[" , type , "]"
                | "(" , ")"
                | path ;

primitive_type  = "i8" | "i16" | "i32" | "i64" | "i128"
                | "u8" | "u16" | "u32" | "u64" | "u128" | "usize"
                | "f16" | "bf16" | "f32" | "f64" | "fp8" | "i4"
                | "bool" | "str" ;

fixed_type      = ( "fx" | "ufx" ) , "[" , const_expr , "," , const_expr , "]" ;
                (* R-TYP-004: 1 <= I, 1 <= F, I + F <= 128. *)

array_type      = "[" , type , ";" , const_expr , "]" ;
slice_type      = "[" , type , "]" ;

generic_type    = path , "[" , type , { "," , const_expr } , "]" ;
                (* R-TYP-030: `Tensor[f32, 784, 128]` - first argument is the
                   element type, the rest are const-generic dimensions. *)

const_expr      = const_atom , { ( "+" | "*" ) , const_atom } ;
                (* R-TYP-031: literals, `+`, `*` only. *)
const_atom      = INT_LITERAL | const_expr_ref | "(" , const_expr , ")" ;
const_expr_ref  = IDENT | path ;


(* ---------------------------------------------------------------- blocks *)
(* R-EXP-001 *)

block           = "{" , { statement } , [ expr ] , "}" ;


(* ------------------------------------------------------------ statements *)

statement       = let_stmt
                | assign_stmt
                | expr_stmt
                | if_stmt
                | rev_if_stmt
                | for_stmt
                | match_stmt
                | return_stmt
                | rev_stmt
                | local_stmt
                | delocal_stmt
                | discard_stmt
                | "break" , ";"
                | "continue" , ";"
                | ";" ;

let_stmt        = "let" , [ "mut" ] , IDENT , [ ":" , type ] , "=" , expr , ";" ;

assign_stmt     = place , assign_op , expr , ";" ;
assign_op       = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "^=" | "&=" | "|="
                | "<<=" | ">>=" | "+%=" | "-%=" | "*%=" | "+|" , "=" | "-|" , "=" | "*|" , "=" ;
                (* R-EXP-020: `+%=` etc. are single tokens (R-LEX-011). *)

expr_stmt       = expr , ";" ;

if_stmt         = "if" , expr , block , [ "else" , ( block | if_stmt ) ] ;
                (* An ordinary conditional. Irreversible, so not allowed in `rev fn`. *)

rev_if_stmt     = "if" , expr , block , "else" , block , "fi" , expr , ";" ;
                (* R-REV-040: the `fi` witness is mandatory and must be a place
                   that was false before the statement (DECISIONS [149]). *)

for_stmt        = "for" , IDENT , "in" , expr , ".." , expr , block ;
                (* R-EXP-070: half-open range only. *)

match_stmt      = "match" , expr , "{" , match_arm , { "," , match_arm } , [ "," ] , "}" ;
match_arm       = pattern , [ "if" , expr ] , "=>" , ( block | expr ) ;
pattern         = "_"
                | IDENT
                | path , [ "(" , pattern , { "," , pattern } , ")" ]
                | literal_pattern ;
literal_pattern = INT_LITERAL | FLOAT_LITERAL | STRING | "true" | "false" ;

return_stmt     = "return" , [ expr ] , ";" ;

rev_stmt        = "reverse" , ( IDENT , "(" , [ arg_list ] , ")" | block ) ;
                (* R-FN-001: the inverse operator. `reverse f(a, b)` and
                   `reverse { ... }` (R-121). *)

local_stmt      = "local" , IDENT , "=" , expr , ";" ;
delocal_stmt    = "delocal" , IDENT , "=" , expr , ";" ;
                (* R-REV-050: `delocal` asserts equality then removes the place. *)

discard_stmt    = "discard" , "(" , expr , ")" , ";" ;
                (* R-EXP-080: carries `erase`. *)


(* --------------------------------------------------- reversible primitives *)
(* R-REV-020..026: these are STATEMENTS. Using one as an expression is E0141. *)

rev_primitive   = rev_update | rev_swap | rev_rotate | rev_not ;

rev_update      = place , ( "+%=" | "-%=" | "^=" | "*%=" ) , expr , ";" ;
                (* P1..P4. For `*%=` the right side must be an odd comptime
                   constant (R-REV-024); for the others it must not read the
                   target place (R-REV-030). *)

rev_swap        = "swap" , "(" , place , "," , place , ")" , ";" ;
rev_rotate      = ( "rotl" | "rotr" ) , "(" , place , "," , const_expr , ")" , ";" ;
                (* R-REV-023: the amount is a comptime constant. *)
rev_not         = "not" , "(" , place , ")" , ";" ;


(* ----------------------------------------------------------- expressions *)

expr            = logic_or ;
logic_or        = logic_and , { "||" , logic_and } ;
logic_and       = comparison , { "&&" , comparison } ;
comparison      = bit_or , { ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) , bit_or } ;
bit_or          = bit_xor , { "|" , bit_xor } ;
bit_xor         = bit_and , { "^" , bit_and } ;
bit_and         = shift , { "&" , shift } ;
shift           = additive , { ( "<<" | ">>" ) , additive } ;
additive        = multiplicative , { ( "+" | "-" | "+%" | "-%" | "+|" | "-|" ) , multiplicative } ;
multiplicative  = cast , { ( "*" | "/" | "%" | "*%" | "*|" ) , cast } ;
cast            = unary , { ( "as" | "as_wrapping" ) , type } ;
unary           = ( "!" | "~" | "-" ) , unary | postfix ;
                (* R-EXP-011: bitwise binds tighter than comparison, which the
                   chain above enforces structurally. *)

postfix         = primary , { call_suffix | index_suffix | field_suffix | "?" } ;
call_suffix     = "(" , [ arg_list ] , ")" ;
index_suffix    = "[" , expr , "]" ;
field_suffix    = "." , IDENT ;

primary         = literal
                | path
                | "(" , expr , ")"
                | array_literal
                | struct_literal
                | block ;

literal         = INT_LITERAL | FLOAT_LITERAL | STRING | "true" | "false" ;
array_literal   = "[" , [ expr , { "," , expr } , [ "," ] ] , "]" ;
struct_literal  = path , "{" , [ field_init , { "," , field_init } , [ "," ] ] , "}" ;
field_init      = IDENT , ":" , expr ;

arg_list        = expr , { "," , expr } ;
place           = path | IDENT ;
                (* A place is assignable and can be passed `inout`. *)


(* ----------------------------------------------------------------- lexical *)

IDENT           = ( LETTER | "_" ) , { LETTER | DIGIT | "_" } ;
                (* R-LEX-004: ASCII only. *)
LETTER          = "A" | ... | "Z" | "a" | ... | "z" ;
DIGIT           = "0" | ... | "9" ;

INT_LITERAL     = decimal | hex | binary | octal , [ suffix ] ;
decimal         = DIGIT , { [ "_" ] , DIGIT } ;
hex             = "0x" , HEXDIGIT , { [ "_" ] , HEXDIGIT } ;
binary          = "0b" , ( "0" | "1" ) , { [ "_" ] , ( "0" | "1" ) } ;
octal           = "0o" , OCTDIGIT , { [ "_" ] , OCTDIGIT } ;
suffix          = "u8" | "u16" | "u32" | "u64" | "u128" | "usize"
                | "i8" | "i16" | "i32" | "i64" | "i128" ;

FLOAT_LITERAL   = DIGIT , { DIGIT | "_" } , ( "." , DIGIT , { DIGIT | "_" } ) ,
                  [ ( "e" | "E" ) , [ "+" | "-" ] , DIGIT , { DIGIT } ] , [ float_suffix ]
                | DIGIT , { DIGIT | "_" } , ( "e" | "E" ) , [ "+" | "-" ] , DIGIT , { DIGIT } ,
                  [ float_suffix ] ;
                (* R-LEX-006: `1.` and `.5` are errors; a `.` or an exponent is
                   required. *)
float_suffix    = "f16" | "bf16" | "f32" | "f64" ;

STRING          = '"' , { STRING_CHAR | ESCAPE | INTERPOLATION } , '"' ;
INTERPOLATION   = "{" , expr , "}" ;

COMMENT         = "#" , { ANY_CHAR - NEWLINE } ;
DOC_COMMENT     = "///" , { ANY_CHAR - NEWLINE } ;
                (* R-LEX-003: line comments only. *)
